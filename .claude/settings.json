{
  "permissions": {
    "allow": [
      "Bash(rclone lsf *)",
      "Bash(rclone lsd *)",
      "Bash(rclone ls *)",
      "Bash(rclone lsl *)",
      "Bash(rclone lsjson *)",
      "Bash(rclone check *)",
      "Bash(rclone listremotes)",
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(npx jest *)",
      "Bash(npx eslint *)",
      "Bash(npm run test:e2e*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-start.sh"
          }
        ]
      }
    ]
  }
}
