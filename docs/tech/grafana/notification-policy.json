{
    "receiver": "admin-email",
    "group_by": [
        "grafana_folder",
        "alertname"
    ],
    "routes": [
        {
            "receiver": "admin-email",
            "object_matchers": [
                [
                    "severity",
                    "=",
                    "warning"
                ]
            ],
            "repeat_interval": "1d"
        }
    ],
    "group_wait": "30s",
    "group_interval": "5m",
    "repeat_interval": "4h"
}
